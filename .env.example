# Copy to .env and replace the local placeholders.
POSTGRES_USER=flowgen
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=flowgen
POSTGRES_PORT=5433
DATABASE_URL=postgresql://flowgen:replace-with-a-local-password@localhost:5433/flowgen?schema=public

# 32 random bytes encoded as 64 hexadecimal characters. Generate with:
# openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

PORT=4000
# Development-only fixed identity. The API and UI ignore this flag outside dev mode.
LOCAL_AUTH_BYPASS=true
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:4000/subscriptions

# Optional until you disable LOCAL_AUTH_BYPASS. Get these from https://dashboard.clerk.com/
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
